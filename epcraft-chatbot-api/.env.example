# Local development only. Never commit a real .env file.
GOOGLE_API_KEY=replace_with_your_gemini_api_key
SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase anon key only if your RLS policy permits product reads.
# Never expose a service-role key in browser code.
SUPABASE_KEY=replace_with_your_supabase_key
# Comma-separated allowed frontend addresses. Your live Vercel site is included as an example.
ALLOWED_ORIGINS=http://localhost:3000,https://ep-craft.vercel.app
